# Will ensure all instances of a process open and close within the runtime of the script.

appString="Thorium"

ensureClose() {
    while pgrep "$appString" > /dev/null; do
	killall "$appString" 
	echo "[X] Killing $appString..."
	sleep 1
    done
    return
}

coreWipe() {
    cd ~ || return
    files=(core.*)

    echo "[!] Moving the following files:"
    printf '%s\n' "${files[@]}"

    count=${#files[@]}
    mv "${files[@]}" ~/Downloads/corefiles/
    echo "Moved $count files."
}

# Ensure arguments are provided
if [ -z "$appString" ]; then
  echo "Usage: $0 steam"
  exit 1
fi

ensureClose
echo "[!] No $appString instances."
echo "[-] Launching $appString..."
"$appString" 
echo "[!] $appString closed, ensuring full closure."
ensureClose
coreWipe
echo "[-] Finished."
