-- Configuration settings: https://conky.cc/config_settings

conky.config = {

    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = 'white',
    default_outline_color = 'white',
    default_shade_color = 'white',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'DejaVu Sans Mono:size=12',
    gap_x = 60,
    gap_y = 60,
    minimum_height = 5,
    minimum_width = 5,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_wayland = false,
    out_to_x = true,

    own_window_class = 'Conky',
    own_window_hints = 'undecorated,sticky,below,skip_taskbar,skip_pager',
    own_window = true,
    own_window_type = 'desktop',


    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 1.0,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,
}

-- Variables: https://conky.cc/variables
conky.text = [[
${color grey}> ${scroll 32 $sysname $nodename $kernel
$machine} <
$hr
${color grey}Uptime:$color $uptime
${time %a %b %d %I:%M:%S %p %Z %Y}
${color grey}RAM:$color $memperc% ${membar 4}
${color grey}CPU:$color $cpu% ${cpubar 4}
${color grey}Processes:$color $processes  ${color grey}         | Running:$color $running_processes
${color3}RAM ($mem/$memmax)    | ${color2}CPU:                       
${top name 1} ${top cpu 1}% | ${top_mem name 1} ${top_mem mem 1}% 
${top name 2} ${top cpu 2}% | ${top_mem name 2} ${top_mem mem 2}% 
${top name 3} ${top cpu 3}% | ${top_mem name 3} ${top_mem mem 3}% 
${top name 4} ${top cpu 4}% | ${top_mem name 4} ${top_mem mem 4}% 
${top name 5} ${top cpu 5}% | ${top_mem name 5} ${top_mem mem 5}% 
$hr
${color grey}File systems:
       / $color${fs_used /}/${fs_size /} ${fs_bar 6 /}
${color grey} Second/ $color${fs_used /mnt/Second}/${fs_size /mnt/Second} ${fs_bar 6 /mnt/Second/} 
${color grey}  Third/ $color${fs_used /mnt/Third}/${fs_size /mnt/Third} ${fs_bar 6 /mnt/Third/} 
$hr
$hr
${color2}Now Playing:
${execi 2 playerctl -p clementine metadata --format '{{ artist }} – {{ title }}'}
${execi 2 playerctl -p clementine metadata --format '{{ album }}'}
# (${execi 2 playerctl metadata --format '{{ mpris:length }}'})
${execi 2 playerctl status}
# MPD
# ${if_mpd_playing}
# Now Playing:
# Album        : ${mpd_album}
# # Album Artist : ${mpd_albumartist}
# Artist       : ${mpd_artist}
# Title        : ${mpd_title}
# # Track        : ${mpd_track}
# # Date         : ${mpd_date}
# # Comment      : ${mpd_comment 40}
# # Filename     : ${mpd_file}
# # Name Field   : ${mpd_name}
# # Smart Name   : ${mpd_smart 40}
# Status       : ${mpd_status}
# Progress     : ${mpd_elapsed} / ${mpd_length} (${mpd_percent}%)
# ${mpd_bar 6,150}
# # Bitrate      : ${mpd_bitrate} kbps
# # Repeat       : ${mpd_repeat}
# # Random       : ${mpd_random}
# # Volume       : ${mpd_vol}%
# ${else}
# MPD is not playing.
# ${endif}
# $hr
# ${color grey}Networking:
# Up:$color ${upspeed} ${color grey} - Down:$color ${downspeed}
# $hr
# ${color grey}Name              PID     CPU%   MEM%
# ${color lightgrey} ${top name 1} ${top pid 1} ${top cpu 1} ${top mem 1}
# ${color lightgrey} ${top name 2} ${top pid 2} ${top cpu 2} ${top mem 2}
# ${color lightgrey} ${top name 3} ${top pid 3} ${top cpu 3} ${top mem 3}
# ${color lightgrey} ${top name 4} ${top pid 4} ${top cpu 4} ${top mem 4}
$hr

# ${color grey}NPR News:${color}
# ${execpi 300 curl -s https://feeds.npr.org/1004/rss.xml | \
#   xmllint --format - 2>/dev/null | \
#   grep -oP '(?<=<title>)[^<]+' | sed -n '2,11p' | \
