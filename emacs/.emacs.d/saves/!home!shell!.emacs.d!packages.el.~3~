;; === PACKAGES START ===

;; Initialize package.el and add MELPA repo
(require 'package)
(add-to-list 'package-archives
	     '("melpa" . "https://melpa.org/packages/") t)
(package-initialize)

;; annotated minibuf
(use-package marginalia
  :ensure t
  :init (marginalia-mode 1)
  )


;; completion engine
(use-package vertico
  :ensure t
  :config
  (vertico-mode 1))

;; makes c-w work 
(use-package whole-line-or-region
  :ensure t
  :config
  (whole-line-or-region-global-mode 1)
)


(use-package ace-jump-mode
  :ensure t
  :config
  :bind (( "C-x SPC" . ace-jump-mode))
  )

(use-package goto-last-change
  :ensure t
  :config
  :bind (("C-x C-x"     . goto-last-change))  )

;; Spacious Padding (MELPA)
;; (use-package spacious-padding
;;   :ensure t
;;   :config
;;   (spacious-padding-mode 1))

(dolist (hook '(text-mode-hook))
      (add-hook hook (lambda () (flyspell-mode 1))))

;; love this. visual bookmarks
;; bm = baby mama
(use-package bm
  :ensure t
  :bind (
         ("<f2>"     . bm-toggle)
         ("<C-f2>"   . bm-next)
         ("<S-f2>"   . bm-previous)
         )
  )

(use-package undo-tree
  :ensure t
  :bind (
         ("C-x u" . undo-tree-undo)
         ("C-/" . undo-tree-visualize)
         )
  :config
  (global-undo-tree-mode)
  )



(defun eat-right()
  (interactive)
  (split-window-right)
  (eat)
  )

(use-package eat
  :config
  :bind(
        ("C-`" . eat-other-window)
        )

  )


(use-package which-key
  :ensure t
  :config
  (which-key-mode 1)
)


;; Might be obsolete because of ace-jump
;; these binds make it dogshit sadly. 
(use-package jump-char
  :ensure t
  :config
  :bind(
        ( "C-c f" . jump-char-forward)
        ( "C-c F" . jump-char-backward)
;;        (global-set-key (kbd "C-.") 'jump-char-forward)
)

  )

;; http://ergoemacs.org/emacs/elisp_read_file_content.html
;; This is part of dashboard config.


         


(defun bible ()
  "Open the bible."
  (interactive)
  (find-file "~/.emacs.d/jps.txt")
  )

(global-set-key (kbd "C-c M-b") 'bible)

;; Multiple-cursors
(use-package multiple-cursors
  :ensure t
  :bind
  (
  ("C->" . mc/mark-next-like-this)
  ("C-<" . mc/mark-previous-like-this)
  ("C-c C-<" . mc/mark-all-like-this)
  )
  :config
  (setq mc/always-run-for-all t)
  )


;; Disable normal movement
(use-package guru-mode
  :ensure t
  :config
  (guru-global-mode))

;; use markdown mode for markdown files
(use-package markdown-mode
  :ensure t
  :mode ("README\\.md\\'" . gfm-mode)
  :init (setq markdown-command "multimarkdown"))



(use-package denote
  :ensure t
  :hook (dired-mode . denote-dired-mode)
  :bind
  (("C-c n n" . denote)
   ("C-c n r" . denote-rename-file)
   ("C-c n l" . denote-link)
   ("C-c n b" . denote-backlinks)
   ("C-c n d" . denote-dired)
   ("C-c n g" . denote-grep))
  :config
  (setq denote-directory (expand-file-name "~/.note/"))
  
  
  (denote-rename-buffer-mode 1)
  
)

;; PACKAGES END
