;; Initialize package.el and add MELPA repo
(require 'package)
(add-to-list 'package-archives
	     '("melpa" . "https://melpa.org/packages/") t)
(package-initialize)

;; Vertico for Completion (MELPA)
(use-package marginalia
  :ensure t
  :init (marginalia-mode 1)
  )

;; I like this
;; annotated minibuf
(use-package vertico
  :ensure t
  :config
  (vertico-mode 1))

;; makes c-w work 
(use-package whole-line-or-region
  :ensure t
  :config
  (whole-line-or-region-global-mode 1)
)


(use-package ace-jump-mode
  :ensure t
  :config
  :bind (( "C-x SPC" . ace-jump-mode))
  )

(use-package goto-last-change
  :ensure t
  :config
  :bind (("C-x C-x"     . goto-last-change))  )

;; Spacious Padding (MELPA)
;; (use-package spacious-padding
;;   :ensure t
;;   :config
;;   (spacious-padding-mode 1))

(dolist (hook '(text-mode-hook))
      (add-hook hook (lambda () (flyspell-mode 1))))

;; love this. visual bookmarks
(use-package bm
  :ensure t
  :bind (
         ("<f2>"     . bm-toggle)
         ("<C-f2>"   . bm-next)
         ("<S-f2>"   . bm-previous)
         )
  )



(defun eat-right()
  (interactive)
  (split-window-right)
  (eat)
  )

(use-package eat
  :config
  :bind(
        ("C-`" . eat-other-window)
        )

  )


(use-package which-key
  :ensure t
  :config
  (which-key-mode 1)
)





;; Might be obsolete because of ace-jump
;; these binds make it dogshit sadly. 
(use-package jump-char
  :ensure t
  :config
  :bind(
        ( "C-c f" . jump-char-forward)
        ( "C-c F" . jump-char-backward)
;;        (global-set-key (kbd "C-.") 'jump-char-forward)
)

  )

;; http://ergoemacs.org/emacs/elisp_read_file_content.html
;; This is part of dashboard config.



;; Dashboard (MELPA)
(use-package dashboard
  :ensure t
  :config
  (dashboard-setup-startup-hook)
  )
         


(defun bible ()
  "Open the bible."
  (interactive)
  (find-file "~/.emacs.d/jps.txt")
  )

(global-set-key (kbd "C-c M-b") 'bible)

