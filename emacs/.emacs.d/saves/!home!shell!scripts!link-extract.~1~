#!/bin/bash
# Extract links from JSON files
# By: github.com/carrotflowerr
# Written: 2024-12-16
# Updated: 2025-01-10
# Using: Neovim

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <json_file> <pattern>"
    exit 1
fi

json_file="$1"
pattern="$2"

if [ ! -f "$json_file" ]; then
    echo "Error: File '$json_file' not found."
    exit 1
fi

# Main command
grep -oP '"(https?://[^"]+)"' "$json_file" | grep "$pattern"
